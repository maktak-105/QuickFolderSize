#define IDI_ICON1 101
IDI_ICON1 ICON "QuickFolderSize.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "QuickFolderSize.manifest"

1 VERSIONINFO
FILEVERSION 2,0,1,0
PRODUCTVERSION 2,0,1,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104b0"
    BEGIN
      VALUE "CompanyName", "maktak-105"
      VALUE "FileDescription", "QuickFolderSize"
      VALUE "FileVersion", "2.0.1.0"
      VALUE "InternalName", "QuickFolderSize"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "QuickFolderSize.exe"
      VALUE "ProductName", "QuickFolderSize"
      VALUE "ProductVersion", "2.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
